package com.tka.dao;

import java.util.List;

import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.hibernate.Transaction;
import org.hibernate.query.MutationQuery;
import org.hibernate.query.Query;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Repository;

import com.tka.entity.Customer;





@Repository
public class CustomerDao {

	@Autowired
	SessionFactory factory;

	public String insertData(Customer c) {
		Session ss = factory.openSession();
		Transaction tr = ss.beginTransaction();

		ss.persist(c);
		tr.commit();
		ss.close();

		return "Data is  inserted ...! ";

	}

	public String deleteData( int id) {
		Session ss = factory.openSession();
		Transaction tr = ss.beginTransaction();
		
		Customer c = ss.get(Customer.class , id);
		
		String hqlQuery = "Delete from Customer where id=:id";
		MutationQuery query = ss.createMutationQuery(hqlQuery);
		 query.setParameter("id", id);

	        int result = query.executeUpdate();

	        tr.commit();

	        ss.close();

	        if(result > 0) {
	            return "Customer Deleted Successfully!";
	        } else {
	            return "Customer Not Found!";
	        }
		
	}
		
	        public String updateData(Customer c , int id) {
	        	
	        	Session ss  = factory.openSession();
	        	Transaction tr = ss.beginTransaction();
	            Customer cc =ss.get(Customer.class, id );
	            String hqlQuery = "update Customer set firstName=:firstName where id=:id ";
	           MutationQuery query =  ss.createMutationQuery(hqlQuery);
	           query.setParameter("id", c.getId());
	           query.setParameter("firstName", c.getFirstName());
	          
	           int result = query.executeUpdate();
	           tr.commit();
	           ss.close();
	           
	           if(result>0) {
				return "Customer Data Updated...!";
	           }
	           else {
	        	   return "Customer Data Not Updated...!";
	           }       
	           
	}
	        public Customer getSingleData(int id) {
	    		Session ss = factory.openSession();
	    		Transaction tr = ss.beginTransaction();

	    		String hqlQuery = "from Customer where id=:id";

	    		Query<Customer> query = ss.createQuery(hqlQuery, Customer.class);
	    		query.setParameter("id", id);
	    		Customer cc = query.getSingleResult();

	    		tr.commit();
	    		ss.close();

	    		return cc;

	    	}

	        public List<Customer> getAllData() {
	    		Session ss = factory.openSession();
	    		Transaction tr = ss.beginTransaction();

	    		String hqlQuery = "from Customer";

	    		Query<Customer> query = ss.createQuery(hqlQuery, Customer.class);
	    		List<Customer> list = query.getResultList();

	    		tr.commit();
	    		ss.close();

	    		return list;

	    	}
}
