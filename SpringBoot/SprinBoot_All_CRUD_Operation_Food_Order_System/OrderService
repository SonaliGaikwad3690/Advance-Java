package com.tka.service;

import java.util.List;

import org.apache.catalina.User;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.tka.dao.OrderDao;
import com.tka.entity.Order;

@Service
public class OrderService {

	@Autowired
	OrderDao dao;

	public String insertData(Order o) {
		String msg = dao.insertData(o);
		return msg;

	}

	public String deleteData(Long id) {
		String msg = dao.deleteData(id);
		return msg;

	}

	public String updateData(Order o, Long id) {
		String msg = dao.updateData(o, id);
		return msg;

	}

	public Order getSingleData(Long id) {
		Order oo = dao.getSingleData(id);
		return oo;

	}

	public List<Order> getAllData() {
		List<Order> list = dao.getAllData();
		return list;

	}

}
