package com.controller;

import java.util.Scanner;

import com.dao.EmployeeDao;
import com.entity.Address;
import com.entity.Employee;

public class EmployeeController {

	public static void main(String[] args) {

		        Scanner sc = new Scanner(System.in);
		        EmployeeDao dao = new EmployeeDao();

		        while (true) {
		            System.out.println("\n1. Insert\n2. Fetch\n3. Update\n4. Delete\n5. Exit");
		            System.out.print("Enter choice: ");
		            int ch = sc.nextInt();

		            switch (ch) {

		                case 1:
		                    sc.nextLine();
		                    System.out.print("Enter Name: ");
		                    String name = sc.nextLine();

		                    System.out.print("Enter City: ");
		                    String city = sc.nextLine();

		                    System.out.print("Enter State: ");
		                    String state = sc.nextLine();

		                    Address addr = new Address(city, state);
		                    Employee emp = new Employee(name, addr);

		                    dao.insertData(emp);
		                    System.out.println("Inserted Successfully!");
		                    break;

		                case 2:
		                    System.out.print("Enter ID: ");
		                    int id = sc.nextInt();

		                    Employee e = dao.get(id);
		                    if (e != null) {
		                        System.out.println("Name: " + e.getName());
		                        System.out.println("City: " + e.getAddress().getCity());
		                        System.out.println("State: " + e.getAddress().getState());
		                    } else {
		                        System.out.println("Record Not Found");
		                    }
		                    break;

		                case 3:
		                    System.out.print("Enter ID: ");
		                    int uid = sc.nextInt();
		                    sc.nextLine();

		                    System.out.print("Enter New Name: ");
		                    String newName = sc.nextLine();

		                    dao.updateData(uid, newName);
		                    System.out.println("Updated Successfully!");
		                    break;

		                case 4:
		                    System.out.print("Enter ID: ");
		                    int did = sc.nextInt();

		                    dao.deleteData(did);
		                    System.out.println("Deleted Successfully!");
		                    break;

		                case 5:
		                    System.exit(0);

		                default:
		                    System.out.println("Invalid Choice");
		            }
		        }
		    }
		}
