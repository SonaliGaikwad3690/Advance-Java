// modify the list contains only react devs 

const reactDevs = employees.filter(emp => emp.role === "React Developer");

console.log(reactDevs);

// modify the list where if salary < 20000 , give hike of 15%

const updatedSalaries = employees.map(emp => {
  if (emp.salary < 20000) {
    return { ...emp, salary: emp.salary * 1.15 };
  }
  return emp;
});

console.log(updatedSalaries);

// modify the list in case where salary digit count > 5 digit
const digitcount = employees.filter(emp => emp.salary.toString().length > 5);

console.log(digitcount);

// collect all the info & sample example of map & filter 
const names = employees.map(emp => emp.name);
