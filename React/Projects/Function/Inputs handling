import { useState } from "react";

function UserForm() {

  const [name, setName] = useState("");

  return (
    <>
      <input
        type="text"
        placeholder="Enter Name"
        onChange={(e) => setName(e.target.value)}
      />

      <h2>Your Name: {name}</h2>
    </>
  );
}

export default UserForm;
