// switch

let day = 1; // switch uses === to compare the key

switch (day) {
  case 1:
    console.log("sunday");
    break;
  case 2:
    console.log("monday");
    break;
  case 3:
    console.log("tuesday");
    break;
  default:
    console.log("not a valid day");
    break;
}

// looping statements :

// for , while , doWhile , for-in , for-of , map , filter

var sum = 5 + 5;

let fruits = ["mango", "apple", "kiwi", 5, "banana", false, null];

//console.log(fruits);

console.log("----------------------------");

for (let i = 0; i < fruits.length; i++) {
  console.log(fruits[i]);
}
console.log("------ for in loop ----------------------");

for (let i in fruits) {
  if (i == fruits.length - 1) {
    continue;
  } else {
    console.log(fruits[i]);
  }
}
console.log("------ for of loop ----------------------");

for (let v of fruits) {
  if (v == 5 || v == false || v == null) {
    continue; // skip the iteration
  } else {
    console.log(v);
  }
}

let num3 = 10;

while (num3 > 0) {
  console.log(num3);
  num3--;
}

// solve count the digit program , & logical programs to understand loops

let digit = 32145;
let count = 0;

while (digit > 0) {
  count++;

  digit = Math.floor((digit /= 10));
}

console.log(count);
